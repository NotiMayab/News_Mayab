# =============================================================================
# News_Mayab — .gitignore (Seguridad de Estado y Artefactos de Compilación)
# =============================================================================

# 1. NUNCA subir la base de datos SQLite en texto plano ni claves privadas a main (ADR-004)
state.sqlite
state.sqlite-wal
state.sqlite-shm
state.sqlite-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.age
*.key

# 2. Entornos virtuales y artefactos de Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
build/
dist/
*.egg-info/
src/*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 3. Salida compilada de Hugo (Cloudflare Pages compila desde site/content)
site/public/
site/resources/_gen/
site/.hugo_build.lock
