#!/usr/bin/env python3
"""Exporta eventos aprobados/auto-publicados de state.sqlite hacia site/content/eventos/*.md."""

from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT_DIR / "src"))

from mayab_news.db.migrations import apply_migrations, connect_db, sync_sources_catalog  # noqa: E402
from mayab_news.export.hugo_exporter import (  # noqa: E402
    DEFAULT_HUGO_EVENTS_DIR,
    export_publishable_events_to_hugo,
)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Exporta eventos publicables desde SQLite a Hugo y opcionalmente compila el sitio."
    )
    parser.add_argument(
        "--db",
        type=Path,
        default=ROOT_DIR / "state.sqlite",
        help="Ruta al archivo SQLite de estado",
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=DEFAULT_HUGO_EVENTS_DIR,
        help="Directorio de salida para los archivos .md de eventos en Hugo",
    )
    parser.add_argument(
        "--build",
        action="store_true",
        help="Ejecuta `hugo --source site --minify` tras exportar",
    )
    parser.add_argument(
        "--push",
        action="store_true",
        help="Hace git add, commit y push a origin/main de los eventos exportados",
    )
    args = parser.parse_args()

    conn = connect_db(args.db)
    try:
        apply_migrations(conn)
        sync_sources_catalog(conn)
        summary = export_publishable_events_to_hugo(conn, output_dir=args.output_dir)
        print(
            f"[EXPORT OK] eventos_exportados={summary.exported_count} | "
            f"obsoletos_eliminados={summary.removed_stale_count}"
        )
    finally:
        conn.close()

    if args.build:
        if shutil.which("hugo") is None:
            print("Aviso: binario `hugo` no encontrado en PATH; se omitió el build.", file=sys.stderr)
            return 1
        subprocess.run(
            ["hugo", "--source", str(ROOT_DIR / "site"), "--minify"],
            check=True,
        )
        print("[HUGO BUILD OK] Sitio compilado en site/public/")

    if args.push:
        subprocess.run(
            ["git", "add", "site/content/eventos", "site/data"],
            cwd=ROOT_DIR,
            check=False,
        )
        diff_res = subprocess.run(
            ["git", "diff", "--cached", "--quiet"],
            cwd=ROOT_DIR,
            check=False,
        )
        if diff_res.returncode != 0:
            subprocess.run(
                ["git", "commit", "-m", "content(eventos): corte editorial publicado"],
                cwd=ROOT_DIR,
                check=True,
            )
            subprocess.run(
                ["git", "push", "origin", "main"],
                cwd=ROOT_DIR,
                check=True,
            )
            print("[GIT PUSH OK] Eventos exportados subidos a origin/main.")
        else:
            print("[GIT PUSH] Sin cambios nuevos en site/content/eventos.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
